\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}[2026/10/26 v2.3 Custom mathematical preamble]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% options
% analysis/prob/complexity/opt load notation modules.
% pset loads problem/solution, margin notes, and problem-based theorem numbering.
% hideproblemtext enables pset but prints only problem headings, not their bodies.
% Without pset, theorems use section-based numbering.
% coverpage places the title on a separate page.
\newif\ifcoverpage
\newif\ifpreamble@analysis
\newif\ifpreamble@prob
\newif\ifpreamble@complexity
\newif\ifpreamble@opt
\newif\ifpreamble@pset

\DeclareOption{coverpage}{\coverpagetrue}
\DeclareOption{analysis}{\preamble@analysistrue}
\DeclareOption{prob}{\preamble@probtrue}
\DeclareOption{complexity}{\preamble@complexitytrue}
\DeclareOption{opt}{\preamble@opttrue}
\DeclareOption{pset}{\preamble@psettrue}
\DeclareOption{hideproblemtext}{%
  \preamble@psettrue
  \PassOptionsToPackage{hideproblemtext}{preamble-pset}%
}
\ProcessOptions\relax

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% core packages
\RequirePackage{fix-cm}
\RequirePackage[margin=1in]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xparse}

% mathematics packages
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{bm}

% list and enumeration packages
\RequirePackage[shortlabels]{enumitem}

% algorithm packages
\RequirePackage{algorithm}
\RequirePackage[indLines=true,noEnd=true,commentColor=black!60]{algpseudocodex}
\algrenewcommand{\algorithmicrequire}{\textbf{Input:}}
\algrenewcommand{\algorithmicensure}{\textbf{Output:}}

% layout and formatting
\RequirePackage{multicol}
\RequirePackage{marvosym}

% fonts
\RequirePackage{newpxtext}
\RequirePackage{newpxmath}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=cyan,
  filecolor=red,
  urlcolor=blue,
}

% named references: load after hyperref/amsthm, before theorem definitions.
% use \cref{label} in prose and \Cref{label} at the start of a sentence.
\RequirePackage[noabbrev,nameinlink]{cleveref}
\crefname{notation}{notation}{notations}
\Crefname{notation}{Notation}{Notations}
\crefname{problem}{problem}{problems}
\Crefname{problem}{Problem}{Problems}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% title and subtitle

\NewDocumentCommand{\subtitle}{m}{\gdef\@subtitle{#1}}
\providecommand{\@subtitle}{}

% Shared title content; each layout supplies its subtitle, author, and date gaps.
\newcommand{\preamble@titlecontent}[3]{%
  {\LARGE\bfseries \@title \par}
  \ifx\@subtitle\@empty\else\vskip#1 {\large\itshape \@subtitle \par}\fi
  \vskip#2
  {\large\begin{tabular}[t]{c}\@author\end{tabular}\par}
  \vskip#3
  {\normalsize \@date \par}
}

\RenewDocumentCommand{\maketitle}{}{
  \PackageInfo{preamble}{Using custom \maketitle layout (cover aware).}
  \par\begingroup
  \renewcommand{\thefootnote}{\@fnsymbol\c@footnote}
  \let\footnote\thanks
  \ifcoverpage
  % the titlepage resets page numbering. suppress its PDF page anchor so
  % the first content page can safely use page.1; restore the user's setting.
  \begingroup
  \hypersetup{pageanchor=false}
  \begin{titlepage}
    \thispagestyle{cover}
    \vspace*{\fill}
    \begin{center}
      \preamble@titlecontent{0.8em}{1.2em}{0.8em}
    \end{center}
    \@thanks
    \vspace*{\fill}
    \clearpage
  \end{titlepage}
  \endgroup
  \else
  \begin{center}
    \preamble@titlecontent{0.5em}{1em}{0.5em}
  \end{center}
  \@thanks
  \vskip2em
  \fi
  \endgroup
  \setcounter{footnote}{0}
  \global\let\@thanks\@empty
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% page styles
\RequirePackage{fancyhdr}

% accommodate the document's normal font size, including 12pt articles.
\setlength{\headheight}{\dimexpr\baselineskip+2pt\relax}

\fancypagestyle{fancydefault}{
  \fancyhf{}
  \fancyhead[L]{\nouppercase{\leftmark}}
  \fancyhead[R]{\thepage}
  \renewcommand{\headrulewidth}{0.4pt}
  \renewcommand{\footrulewidth}{0pt}
}

\fancypagestyle{cover}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

\pagestyle{fancydefault}

\AtBeginDocument{
  \ifcoverpage
  \thispagestyle{cover}
  \else
  \thispagestyle{fancydefault}
  \fi
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% mathematical operators and notation

\RequirePackage{math-core}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Theorem environments

\theoremstyle{plain}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{claim}[theorem]{Claim}
\newtheorem*{theorem*}{Theorem}
\newtheorem*{lemma*}{Lemma}

\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\newtheorem{notation}[theorem]{Notation}
\newtheorem*{notation*}{Notation}
\newtheorem*{definition*}{Definition}
\newtheorem*{example*}{Example}

% Preserve each reference type with the shared theorem counter, including
% hyperref versions whose theorem patches bypass cleveref's type detection.
% Environment groups keep these aliases local.
\AddToHook{env/lemma/begin}{\crefalias{theorem}{lemma}}
\AddToHook{env/corollary/begin}{\crefalias{theorem}{corollary}}
\AddToHook{env/claim/begin}{\crefalias{theorem}{claim}}
\AddToHook{env/definition/begin}{\crefalias{theorem}{definition}}
\AddToHook{env/example/begin}{\crefalias{theorem}{example}}
\AddToHook{env/notation/begin}{\crefalias{theorem}{notation}}

\theoremstyle{remark}
\newtheorem*{remark}{Remark}

\renewcommand*{\proofname}{Proof}

% \theorembysection  →  Theorem 2.3  (resets per section, default)
% \theorembyproblem  →  Theorem 1.2  (pset module; resets per problem)
\newcommand{\theorembysection}{%
  \@ifundefined{c@problem}{}{\counterwithout{theorem}{problem}}%
  \counterwithin{theorem}{section}%
}
\newcommand{\thmlabel}[1]{\label{thm:#1}}
\newcommand{\lemlabel}[1]{\label{lem:#1}}
\newcommand{\deflabel}[1]{\label{def:#1}}

% theorem style overrides for palatino
\def\th@plain{%
  \thm@notefont{\scshape}
  \itshape
}
\def\th@definition{%
  \thm@notefont{\scshape}
  \normalfont
}
\def\th@remark{%
  \thm@notefont{\scshape}
  \normalfont
}
% start the automatic QED on its own line, keeping amsthm's QED stack
% intact so that \qedhere suppresses it and nested proofs work normally.
\AddToHook{env/proof/end}{\par\nobreak}

% a delayed proof tied to a result label; the result type defaults to Theorem.
% \begin{proofof}[Lemma]{lem:existence} ... \end{proofof}
% one canonical proof anchor per result: \proofref{lem:existence}, or
% \proofref[proof below]{lem:existence} for custom link text.
\newcommand*{\preamble@prooftitle}[2]{%
  \proofname\ of \hyperref[#2]{#1~\ref*{#2}}%
}
\NewDocumentEnvironment{proofof}{O{Theorem} m}
{
  \begin{proof}[\preamble@prooftitle{#1}{#2}]
    \phantomsection\label{proof:#2}\ignorespaces
  }
  {
  \end{proof}
}
\NewDocumentCommand{\proofref}{O{proof} m}{\hyperref[proof:#2]{#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% algorithm environment that splits across pages
\newenvironment{breakablealgorithm}
{% \begin{breakablealgorithm}
  \begin{center}
    \refstepcounter{algorithm}
    \hrule height.8pt depth0pt \kern2pt
    \renewcommand{\caption}[2][\relax]{%
      {\raggedright\textbf{\fname@algorithm~\thealgorithm} ##2\par}%
      \ifx\relax##1\relax
      \addcontentsline{loa}{algorithm}{\protect\numberline{\thealgorithm}##2}%
      \else
      \addcontentsline{loa}{algorithm}{\protect\numberline{\thealgorithm}##1}%
      \fi
      \kern2pt\hrule\kern2pt
    }
  }{% \end{breakablealgorithm}
    \kern2pt\hrule\relax
  \end{center}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% optional problem-set layout and numbering
\theorembysection
\ifpreamble@pset
\RequirePackage{preamble-pset}
\theorembyproblem
\fi

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% document metadata
% Declare \author{...} in the document; no environment or shell lookup.
\date{\today}

