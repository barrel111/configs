% optional math modules
\ifpreamble@analysis\RequirePackage{math-analysis}\fi
\ifpreamble@prob\RequirePackage{math-prob}\fi
\ifpreamble@complexity\RequirePackage{math-complexity}\fi
\ifpreamble@opt
\RequirePackage{math-opt}
\RequirePackage{preamble-envs}
\fi

